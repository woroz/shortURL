<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stats — worito.tech/<%= url.shortUrl %></title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="https://worito.tech/stats/<%= url.shortUrl %>">
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --bg: #f7f5f0; --card: #ffffff; --border: #e8e4dc; --border2: #d4cfc4; --green: #2d6a2d; --green-bg: #eef5ee; --green-light: #c8e6c8; --text: #1a1a1a; --muted: #8a8478; --tag-bg: #f0ede6; }
        body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; }
        nav { border-bottom: 1px solid var(--border); padding: 1.4rem 2.5rem; display: flex; align-items: center; justify-content: space-between; background: rgba(247,245,240,0.85); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; }
        .nav-logo { font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--text); text-decoration: none; font-family: 'DM Sans', sans-serif; }
        .nav-logo em { font-style: normal; color: var(--green); }
        .nav-links { display: flex; gap: 0.5rem; align-items: center; }
        .nav-link { font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--muted); text-decoration: none; padding: 0.35rem 0.8rem; border-radius: 100px; border: 1px solid var(--border2); background: var(--tag-bg); transition: color 0.15s, border-color 0.15s; }
        .nav-link:hover { color: var(--text); border-color: var(--text); }
        .page { max-width: 560px; margin: 0 auto; padding: 3rem 1.5rem 4rem; }
        .back { font-family: 'DM Mono', monospace; font-size: 0.78rem; color: var(--muted); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 2rem; transition: color 0.15s; }
        .back:hover { color: var(--text); }
        .header-card { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 1.75rem; margin-bottom: 1.5rem; display: flex; gap: 1.25rem; align-items: flex-start; }
        .header-favicon { width: 52px; height: 52px; min-width: 52px; background: var(--card); border-radius: 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
        .header-favicon img { width: 36px; height: 36px; object-fit: contain; }
        .header-info { flex: 1; min-width: 0; }
        .header-title { font-size: 1rem; font-weight: 600; margin-bottom: 0.3rem; }
        .header-desc { font-size: 0.78rem; color: var(--muted); font-weight: 300; line-height: 1.5; margin-bottom: 0.75rem; }
        .header-links { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
        .short-badge { font-family: 'DM Mono', monospace; font-size: 0.72rem; background: var(--green-bg); color: var(--green); border: 1px solid var(--green-light); border-radius: 8px; padding: 0.2rem 0.55rem; text-decoration: none; transition: background 0.15s; }
        .short-badge:hover { background: var(--green-light); }
        .copy-btn { font-family: 'DM Mono', monospace; font-size: 0.65rem; background: none; border: 1px solid var(--border2); color: var(--muted); border-radius: 6px; padding: 0.2rem 0.5rem; cursor: pointer; transition: color 0.15s, border-color 0.15s; }
        .copy-btn:hover { color: var(--text); border-color: var(--text); }
        .original-link { font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--muted); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block; margin-top: 0.4rem; }
        .original-link:hover { color: var(--text); }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem 1.5rem; }
        .stat-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
        .stat-value { font-size: 2.2rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
        .stat-value.green { color: var(--green); }
        .preview-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
        .preview-img { width: 100%; max-height: 200px; object-fit: cover; display: block; }
        .preview-body { padding: 1.25rem; }
        .preview-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
        .preview-title { font-size: 0.9rem; font-weight: 500; margin-bottom: 0.4rem; }
        .preview-desc { font-size: 0.78rem; color: var(--muted); font-weight: 300; line-height: 1.5; }
    </style>
</head>
<body>
    <nav>
        <a href="/" class="nav-logo">worito<em>.tech</em></a>
        <div class="nav-links">
            <a href="/" class="nav-link">← enlaces</a>
            <a href="/stats" class="nav-link">estadisticas</a>
        </div>
    </nav>
    <main class="page">
        <a href="/stats" class="back">← volver al resumen</a>
        <div class="header-card">
            <div class="header-favicon">
                <% try { const domain = new URL(url.longUrl).hostname %>
                    <img src="https://www.google.com/s2/favicons?domain=<%= domain %>&sz=64" alt="<%= url.titulo || url.shortUrl %>">
                <% } catch(e) { %>↗<% } %>
            </div>
            <div class="header-info">
                <div class="header-title"><%= url.titulo || 'Sin título' %></div>
                <% if (url.descripcion) { %>
                    <div class="header-desc"><%= url.descripcion %></div>
                <% } %>
                <div class="header-links">
                    <a href="/<%= url.shortUrl %>" target="_blank" class="short-badge">worito.tech/<%= url.shortUrl %></a>
                    <button class="copy-btn" onclick="navigator.clipboard.writeText('https://worito.tech/<%= url.shortUrl %>');this.textContent='copiado';setTimeout(()=>this.textContent='copiar',1800)">copiar</button>
                </div>
                <a href="<%= url.longUrl %>" target="_blank" rel="noopener noreferrer" class="original-link"><%= url.longUrl %></a>
            </div>
        </div>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total clicks</div>
                <div class="stat-value green"><%= url.clicks || 0 %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Alias</div>
                <div class="stat-value" style="font-size:1.2rem; padding-top:0.5rem">/<%= url.shortUrl %></div>
            </div>
        </div>
        <% if (url.imagen) { %>
            <div class="preview-card">
                <img src="<%= url.imagen %>" alt="<%= url.titulo || 'Vista previa' %>" class="preview-img">
                <div class="preview-body">
                    <div class="preview-label">Vista previa del enlace</div>
                    <% if (url.titulo) { %><div class="preview-title"><%= url.titulo %></div><% } %>
                    <% if (url.descripcion) { %><div class="preview-desc"><%= url.descripcion %></div><% } %>
                </div>
            </div>
        <% } %>
    </main>
    <script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
