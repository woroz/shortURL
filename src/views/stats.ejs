<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estadísticas — worito.tech</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="canonical" href="https://worito.tech/stats">
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root { --bg: #f7f5f0; --card: #ffffff; --border: #e8e4dc; --border2: #d4cfc4; --green: #2d6a2d; --green-bg: #eef5ee; --green-light: #c8e6c8; --text: #1a1a1a; --muted: #8a8478; --tag-bg: #f0ede6; }
        body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; }
        nav { border-bottom: 1px solid var(--border); padding: 1.4rem 2.5rem; display: flex; align-items: center; justify-content: space-between; background: rgba(247,245,240,0.85); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; }
        .nav-logo { font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--text); text-decoration: none; font-family: 'DM Sans', sans-serif; }
        .nav-logo em { font-style: normal; color: var(--green); }
        .nav-links { display: flex; gap: 0.5rem; align-items: center; }
        .nav-link { font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--muted); text-decoration: none; padding: 0.35rem 0.8rem; border-radius: 100px; border: 1px solid var(--border2); background: var(--tag-bg); transition: color 0.15s, border-color 0.15s; }
        .nav-link:hover { color: var(--text); border-color: var(--text); }
        .nav-link.active { color: var(--text); border-color: var(--text); background: var(--card); }
        .page { max-width: 560px; margin: 0 auto; padding: 3rem 1.5rem 4rem; }
        .page-label { font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
        .page-label::before { content: ''; display: block; width: 18px; height: 1px; background: var(--muted); }
        h1 { font-size: 2rem; font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 2rem; }
        h1 strong { font-weight: 700; }
        .stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 2rem; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 1.25rem 1.5rem; }
        .stat-label { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; }
        .stat-value { font-size: 2rem; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
        .stat-value.green { color: var(--green); }
        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
        .section-title { font-family: 'DM Mono', monospace; font-size: 0.62rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
        .url-list { display: flex; flex-direction: column; gap: 0.75rem; }
        .url-row { background: var(--card); border: 1px solid var(--border); border-radius: 14px; display: flex; align-items: center; padding: 1rem 1.25rem; gap: 1rem; text-decoration: none; color: var(--text); transition: border-color 0.15s, box-shadow 0.15s; }
        .url-row:hover { border-color: var(--border2); box-shadow: 0 2px 12px rgba(0,0,0,0.06); }
        .url-favicon { width: 36px; height: 36px; min-width: 36px; background: var(--card); border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
        .url-favicon img { width: 36px; height: 36px; object-fit: contain; }
        .url-info { flex: 1; min-width: 0; }
        .url-name { font-size: 0.85rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 0.2rem; }
        .url-short { font-family: 'DM Mono', monospace; font-size: 0.72rem; color: var(--green); }
        .url-clicks { text-align: right; }
        .clicks-num { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
        .clicks-label { font-family: 'DM Mono', monospace; font-size: 0.55rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
        .bar-wrap { height: 3px; background: var(--border); border-radius: 2px; margin-top: 0.6rem; }
        .bar { height: 3px; background: var(--green); border-radius: 2px; }
        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--muted); }
        .empty-state p { font-size: 0.82rem; font-weight: 300; }
    </style>
</head>
<body>
    <nav>
        <a href="/" class="nav-logo">worito<em>.tech</em></a>
        <div class="nav-links">
            <a href="/" class="nav-link">← enlaces</a>
            <a href="/stats" class="nav-link active">estadisticas</a>
        </div>
    </nav>
    <main class="page">
        <div class="page-label">resumen</div>
        <h1>Tus <strong>estadisticas</strong></h1>
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Total enlaces</div>
                <div class="stat-value"><%= urls.length %></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total clicks</div>
                <div class="stat-value green"><%= totalClicks %></div>
            </div>
        </div>
        <div class="section-header">
            <span class="section-title">Ranking por clicks</span>
        </div>
        <% const maxClicks = urls.reduce((max, u) => Math.max(max, Number(u.clicks) || 0), 1) %>
        <div class="url-list">
            <% if (urls && urls.length > 0) { %>
                <% const sorted = [...urls].sort((a,b) => (Number(b.clicks)||0) - (Number(a.clicks)||0)) %>
                <% sorted.forEach(function(url) { %>
                    <a href="/stats/<%= url.shortUrl %>" class="url-row">
                        <div class="url-favicon">
                            <% try { const domain = new URL(url.longUrl).hostname %>
                                <img src="https://www.google.com/s2/favicons?domain=<%= domain %>&sz=64" alt="<%= url.titulo || url.shortUrl %>">
                            <% } catch(e) { %>↗<% } %>
                        </div>
                        <div class="url-info">
                            <div class="url-name"><%= url.titulo || url.longUrl %></div>
                            <div class="url-short">worito.tech/<%= url.shortUrl %></div>
                            <div class="bar-wrap">
                                <% const widthPct = Math.round(((Number(url.clicks) || 0) / maxClicks) * 100) %>
                                <div class="bar" style="width:<%- widthPct %>%"></div>
                            </div>
                        </div>
                        <div class="url-clicks">
                            <div class="clicks-num"><%= url.clicks || 0 %></div>
                            <div class="clicks-label">clicks</div>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="empty-state"><p>Todavia no tenes enlaces.</p></div>
            <% } %>
        </div>
    </main>
    <script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
