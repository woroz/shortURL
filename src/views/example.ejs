<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acortador de URLs gratis — worito.tech</title>
    <meta name="description" content="Acortá tus URLs gratis con worito.tech. Creá links cortos, personalizados y con estadísticas de clicks en segundos. Sin registro.">
    <meta name="keywords" content="acortador de urls, acortar url, url corta, link corto, acortador de links, short url, acortador gratis, acortador sin registro">
    <meta name="robots" content="index, follow">
    <meta name="author" content="worito.tech">
    <link rel="canonical" href="https://worito.tech">
    
    <meta name="google-site-verification" content="gei_mqgFhTYQQ7j9dbQgGfVqM-IYqnPHyUZzCg2uH6Y" />
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://worito.tech">
    <meta property="og:title" content="Acortador de URLs gratis — worito.tech">
    <meta property="og:description" content="Acortá tus URLs gratis. Creá links cortos y personalizados con estadísticas de clicks. Sin registro.">
    <meta property="og:locale" content="es_AR">

    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Acortador de URLs gratis — worito.tech">
    <meta name="twitter:description" content="Acortá tus URLs gratis. Links cortos, personalizados y con estadísticas.">

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "worito.tech",
        "url": "https://worito.tech",
        "description": "Acortador de URLs gratis. Creá links cortos y personalizados con estadísticas de clicks.",
        "applicationCategory": "UtilitiesApplication",
        "operatingSystem": "Web",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "inLanguage": "es"
    }
    </script>

    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #f7f5f0; --card: #ffffff; --border: #e8e4dc; --border2: #d4cfc4;
            --green: #2d6a2d; --green-bg: #eef5ee; --green-light: #c8e6c8;
            --text: #1a1a1a; --muted: #8a8478; --tag-bg: #f0ede6;
            --red: #c0392b;
        }
        body { background: var(--bg); color: var(--text); font-family: 'DM Sans', sans-serif; min-height: 100vh; padding: 0; }

        nav { border-bottom: 1px solid var(--border); padding: 1.4rem 2.5rem; display: flex; align-items: center; justify-content: space-between; background: rgba(247,245,240,0.85); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; }
        .nav-logo { font-family: 'DM Sans', sans-serif; font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; color: var(--text); text-decoration: none; }
        .nav-logo em { font-style: normal; color: var(--green); }
        .nav-links { display: flex; gap: 0.5rem; align-items: center; }
        .nav-link { font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--muted); text-decoration: none; padding: 0.35rem 0.8rem; border-radius: 100px; border: 1px solid var(--border2); background: var(--tag-bg); transition: color 0.15s, border-color 0.15s; }
        .nav-link:hover { color: var(--text); border-color: var(--text); }
        .nav-link.active { color: var(--text); border-color: var(--text); background: var(--card); }

        .hero { max-width: 560px; margin: 0 auto; padding: 4rem 1.5rem 2rem; }
        .hero-label { font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
        .hero-label::before { content: ''; display: block; width: 18px; height: 1px; background: var(--muted); }
        .hero h1 { font-size: 2.4rem; font-weight: 300; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 1rem; }
        .hero h1 strong { font-weight: 700; }
        .hero-desc { font-size: 0.9rem; color: var(--muted); font-weight: 300; line-height: 1.6; margin-bottom: 2rem; }

        .form-card { background: var(--card); border-radius: 20px; padding: 1.75rem; margin-bottom: 1rem; box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
        .field { margin-bottom: 1rem; }
        .field label { font-family: 'DM Mono', monospace; font-size: 0.6rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 0.5rem; }
        input[type="text"] { width: 100%; background: var(--bg); border: 1px solid var(--border2); border-radius: 12px; color: var(--text); font-family: 'DM Mono', monospace; font-size: 0.85rem; padding: 0.85rem 1rem; outline: none; transition: border-color 0.15s, box-shadow 0.15s; }
        input[type="text"]:focus { border-color: var(--text); box-shadow: 0 0 0 3px rgba(26,26,26,0.06); }
        input[type="text"]::placeholder { color: #c0bbb2; }
        .alias-wrap { display: flex; align-items: center; background: var(--bg); border: 1px solid var(--border2); border-radius: 12px; overflow: hidden; transition: border-color 0.15s, box-shadow 0.15s; }
        .alias-wrap:focus-within { border-color: var(--text); box-shadow: 0 0 0 3px rgba(26,26,26,0.06); }
        .alias-prefix { font-family: 'DM Mono', monospace; font-size: 0.8rem; color: var(--green); padding: 0.85rem 0.5rem 0.85rem 1rem; white-space: nowrap; user-select: none; }
        .alias-wrap input { border: none; border-radius: 0; background: transparent; box-shadow: none; padding-left: 0.25rem; }
        .alias-wrap input:focus { box-shadow: none; }
        .divider { height: 1px; background: var(--border); margin: 1.25rem 0; }
        .btn { width: 100%; padding: 0.9rem 1rem; background: var(--text); color: #f7f5f0; border: none; border-radius: 12px; font-family: 'DM Sans', sans-serif; font-size: 0.9rem; font-weight: 500; cursor: pointer; letter-spacing: -0.01em; transition: opacity 0.15s, transform 0.1s; display: flex; align-items: center; justify-content: center; gap: 0.4rem; }
        .btn:hover { opacity: 0.82; }
        .btn:active { transform: scale(0.99); }

        /* FEATURES */
        .features { max-width: 560px; margin: 0 auto; padding: 0 1.5rem 2.5rem; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; }
        .feature { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 1rem 1.1rem; }
        .feature-icon { font-size: 1.1rem; margin-bottom: 0.4rem; }
        .feature-title { font-size: 0.8rem; font-weight: 600; margin-bottom: 0.2rem; }
        .feature-desc { font-size: 0.7rem; color: var(--muted); font-weight: 300; line-height: 1.4; }

        .urls-section { max-width: 560px; margin: 0 auto; padding: 0 1.5rem 4rem; }
        .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
        .section-title { font-family: 'DM Mono', monospace; font-size: 0.62rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
        .count-badge { font-family: 'DM Mono', monospace; font-size: 0.62rem; background: var(--tag-bg); border: 1px solid var(--border2); color: var(--muted); padding: 0.15rem 0.5rem; border-radius: 100px; }

        .url-list { display: flex; flex-direction: column; gap: 0.75rem; }
        .url-card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; transition: box-shadow 0.15s; }
        .url-card:hover { box-shadow: 0 2px 16px rgba(0,0,0,0.06); }
        .url-card.deleting { opacity: 0; transform: translateX(20px); transition: all 0.25s ease; }
        .url-main { display: flex; }
        .url-img { width: 90px; min-width: 90px; background: var(--card); overflow: hidden; display: flex; align-items: center; justify-content: center; }
        .url-img img { width: 32px; height: 32px; object-fit: contain; }
        .url-img-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; color: var(--border2); }
        .url-content { padding: 1rem 1.1rem; flex: 1; display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; border-left: 1px solid var(--border); }
        .url-title { font-size: 0.88rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .url-desc { font-size: 0.75rem; color: var(--muted); font-weight: 300; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .url-meta { margin-top: 0.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
        .short-link { font-family: 'DM Mono', monospace; font-size: 0.72rem; background: var(--green-bg); color: var(--green); border: 1px solid var(--green-light); border-radius: 8px; padding: 0.2rem 0.55rem; text-decoration: none; transition: background 0.15s; }
        .short-link:hover { background: var(--green-light); }
        .action-btn { font-family: 'DM Mono', monospace; font-size: 0.65rem; background: none; border: 1px solid var(--border2); color: var(--muted); border-radius: 6px; padding: 0.2rem 0.5rem; cursor: pointer; transition: color 0.15s, border-color 0.15s; text-decoration: none; display: inline-flex; align-items: center; }
        .action-btn:hover { color: var(--text); border-color: var(--text); }
        .action-btn.danger:hover { color: var(--red); border-color: var(--red); }
        .original-link { display: block; font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--muted); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 0.15rem; }
        .original-link:hover { color: var(--text); }
        .edit-bar { display: none; border-top: 1px solid var(--border); padding: 0.75rem 1rem; background: var(--tag-bg); }
        .edit-bar.visible { display: flex; gap: 0.5rem; align-items: center; }
        .edit-prefix { font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--green); white-space: nowrap; }
        .edit-input { flex: 1; background: var(--card); border: 1px solid var(--border2); border-radius: 8px; font-family: 'DM Mono', monospace; font-size: 0.8rem; padding: 0.4rem 0.7rem; color: var(--text); outline: none; transition: border-color 0.15s; }
        .edit-input:focus { border-color: var(--text); }
        .edit-save { font-family: 'DM Mono', monospace; font-size: 0.65rem; background: var(--text); color: #f7f5f0; border: none; border-radius: 6px; padding: 0.4rem 0.8rem; cursor: pointer; transition: opacity 0.15s; }
        .edit-save:hover { opacity: 0.8; }
        .edit-cancel { font-family: 'DM Mono', monospace; font-size: 0.65rem; background: none; border: 1px solid var(--border2); color: var(--muted); border-radius: 6px; padding: 0.4rem 0.7rem; cursor: pointer; }
        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--muted); }
        .empty-state p { font-size: 0.82rem; font-weight: 300; }

        /* FAQ */
        .faq-section { max-width: 560px; margin: 0 auto; padding: 0 1.5rem 4rem; }
        .faq-label { font-family: 'DM Mono', monospace; font-size: 0.62rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1rem; }
        .faq-item { border-top: 1px solid var(--border); padding: 1rem 0; }
        .faq-item:last-child { border-bottom: 1px solid var(--border); }
        .faq-q { font-size: 0.88rem; font-weight: 500; margin-bottom: 0.4rem; }
        .faq-a { font-size: 0.8rem; color: var(--muted); font-weight: 300; line-height: 1.6; }

        .toast { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--text); color: #f7f5f0; font-family: 'DM Mono', monospace; font-size: 0.75rem; padding: 0.6rem 1.2rem; border-radius: 100px; opacity: 0; transition: all 0.2s ease; pointer-events: none; z-index: 100; white-space: nowrap; }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
        .toast.error { background: var(--red); }
    </style>
</head>
<body>
    <div class="toast" id="toast"></div>

    <nav>
        <a href="/" class="nav-logo">worito<em>.tech</em></a>
        <div class="nav-links">
            <a href="/stats" class="nav-link">estadísticas</a>
            <span class="nav-link active">enlaces</span>
        </div>
    </nav>

    <main>
        <div class="hero">
            <div class="hero-label">acortador de urls gratis</div>
            <h1>URLs <strong>cortas</strong>,<br>links que duran.</h1>
            <p class="hero-desc">Acortá cualquier URL en segundos. Creá links personalizados, compartílos y seguí los clicks desde tu panel. Gratis, sin registro.</p>

            <div class="form-card">
                <form id="urlForm">
                    <div class="field">
                        <label>URL larga</label>
                        <input type="text" name="longUrl" placeholder="https://ejemplo.com/una-url-muy-larga" required>
                    </div>
                    <div class="field">
                        <label>Alias personalizado — opcional</label>
                        <div class="alias-wrap">
                            <span class="alias-prefix">worito.tech/</span>
                            <input type="text" name="customAlias" placeholder="mi-alias">
                        </div>
                    </div>
                    <div class="divider"></div>
                    <button type="submit" class="btn" id="submitBtn">
                        Acortar enlace
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </button>
                </form>
            </div>
        </div>

        <div class="features">
            <div class="feature">
                <div class="feature-title">Instantaneo</div>
                <div class="feature-desc">Acorta cualquier URL en menos de un segundo.</div>
            </div>
            <div class="feature">
                <div class="feature-title">Personalizado</div>
                <div class="feature-desc">Elegi el alias que quieras para tu link.</div>
            </div>
            <div class="feature">
                <div class="feature-title">Estadisticas</div>
                <div class="feature-desc">Segui cuantos clicks recibe cada link.</div>
            </div>
        </div>

        <div class="urls-section">
            <div class="section-header">
                <span class="section-title">Mis enlaces</span>
                <% if (urls && urls.length > 0) { %>
                    <span class="count-badge" id="countBadge"><%= urls.length %></span>
                <% } %>
            </div>

            <div class="url-list" id="urlList">
                <% if (urls && urls.length > 0) { %>
                    <% urls.forEach(function(url) { %>
                        <article class="url-card" data-short="<%= url.shortUrl %>">
                            <div class="url-main">
                                <div class="url-img">
                                    <% try { const domain = new URL(url.longUrl).hostname %>
                                        <img src="https://www.google.com/s2/favicons?domain=<%= domain %>&sz=64" alt="<%= url.titulo || url.shortUrl %>">
                                    <% } catch(e) { %>
                                        <div class="url-img-placeholder">↗</div>
                                    <% } %>
                                </div>
                                <div class="url-content">
                                    <% if (url.titulo) { %><div class="url-title"><%= url.titulo %></div><% } %>
                                    <% if (url.descripcion) { %><div class="url-desc"><%= url.descripcion %></div><% } %>
                                    <div class="url-meta">
                                        <a href="/<%= url.shortUrl %>" target="_blank" class="short-link short-link-display" title="Ir a worito.tech/<%= url.shortUrl %>">worito.tech/<%= url.shortUrl %></a>
                                        <button class="action-btn" onclick="copiar(this, 'https://worito.tech/<%= url.shortUrl %>')">copiar</button>
                                        <a href="/stats/<%= url.shortUrl %>" class="action-btn">stats</a>
                                        <button class="action-btn" onclick="toggleEdit(this)">editar</button>
                                        <button class="action-btn danger" onclick="eliminar(this)">borrar</button>
                                    </div>
                                    <a href="<%= url.longUrl %>" target="_blank" rel="noopener noreferrer" class="original-link"><%= url.longUrl %></a>
                                </div>
                            </div>
                            <div class="edit-bar">
                                <span class="edit-prefix">worito.tech/</span>
                                <input class="edit-input" type="text" value="<%= url.shortUrl %>" placeholder="nuevo-alias">
                                <button class="edit-save" onclick="guardarAlias(this)">guardar</button>
                                <button class="edit-cancel" onclick="cancelarEdit(this)">✕</button>
                            </div>
                        </article>
                    <% }); %>
                <% } else { %>
                    <div class="empty-state" id="emptyState">
                        <p>Todavia no acortaste ningún enlace.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <section class="faq-section">
            <div class="faq-label">Preguntas frecuentes</div>
            <div itemscope itemtype="https://schema.org/FAQPage">
                <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <div class="faq-q" itemprop="name">¿Como acorto una URL?</div>
                    <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <span itemprop="text">Pega tu URL larga en el campo de arriba, elegí un alias personalizado (opcional) y hacé click en "Acortar enlace". Tu link corto queda listo al instante.</span>
                    </div>
                </div>
                <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <div class="faq-q" itemprop="name">¿Es gratis?</div>
                    <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <span itemprop="text">Si, worito.tech es completamente gratis. No necesitas registrarte ni pagar nada para acortar URLs.</span>
                    </div>
                </div>
                <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <div class="faq-q" itemprop="name">¿Puedo personalizar el link?</div>
                    <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <span itemprop="text">Si. Podes elegir el alias que quieras, por ejemplo worito.tech/mi-link, siempre que no este en uso.</span>
                    </div>
                </div>
                <div class="faq-item" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
                    <div class="faq-q" itemprop="name">¿Puedo ver cuantas veces se uso mi link?</div>
                    <div class="faq-a" itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                        <span itemprop="text">Sí. Cada link tiene su propia página de estadisticas donde podes ver el total de clicks.</span>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
    function toast(msg, error = false) {
        const t = document.getElementById('toast')
        t.textContent = msg
        t.className = 'toast show' + (error ? ' error' : '')
        setTimeout(() => t.className = 'toast', 2200)
    }

    document.getElementById('urlForm').addEventListener('submit', async (e) => {
        e.preventDefault()
        const btn = document.getElementById('submitBtn')
        btn.textContent = 'Acortando...'
        btn.disabled = true
        const formData = new FormData(e.target)
        try {
            const res = await fetch('/url', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ longUrl: formData.get('longUrl'), customAlias: formData.get('customAlias') })
            })
            const data = await res.json()
            if (data.error) { toast(data.error, true); return }
            agregarUrlCard(data)
            e.target.reset()
            actualizarContador(1)
            toast('✓ enlace creado')
        } catch { toast('Error al acortar la URL', true) }
        finally {
            btn.innerHTML = 'Acortar enlace <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>'
            btn.disabled = false
        }
    })

    function agregarUrlCard(url) {
        const list = document.getElementById('urlList')
        const empty = document.getElementById('emptyState')
        if (empty) empty.remove()
        const domain = (() => { try { return new URL(url.longUrl).hostname } catch { return '' } })()
        const card = document.createElement('article')
        card.className = 'url-card'
        card.dataset.short = url.shortUrl
        card.innerHTML = `
            <div class="url-main">
                <div class="url-img">
                    ${domain ? `<img src="https://www.google.com/s2/favicons?domain=${domain}&sz=64" alt="${url.titulo || url.shortUrl}">` : `<div class="url-img-placeholder">↗</div>`}
                </div>
                <div class="url-content">
                    ${url.titulo ? `<div class="url-title">${url.titulo}</div>` : ''}
                    ${url.descripcion ? `<div class="url-desc">${url.descripcion}</div>` : ''}
                    <div class="url-meta">
                        <a href="/${url.shortUrl}" target="_blank" class="short-link short-link-display">worito.tech/${url.shortUrl}</a>
                        <button class="action-btn" onclick="copiar(this, 'https://worito.tech/${url.shortUrl}')">copiar</button>
                        <a href="/stats/${url.shortUrl}" class="action-btn stats-link">stats</a>
                        <button class="action-btn" onclick="toggleEdit(this)">editar</button>
                        <button class="action-btn danger" onclick="eliminar(this)">borrar</button>
                    </div>
                    <a href="${url.longUrl}" target="_blank" rel="noopener noreferrer" class="original-link">${url.longUrl}</a>
                </div>
            </div>
            <div class="edit-bar">
                <span class="edit-prefix">worito.tech/</span>
                <input class="edit-input" type="text" value="${url.shortUrl}" placeholder="nuevo-alias">
                <button class="edit-save" onclick="guardarAlias(this)">guardar</button>
                <button class="edit-cancel" onclick="cancelarEdit(this)">✕</button>
            </div>
        `
        list.prepend(card)
    }

    function actualizarContador(delta) {
        let badge = document.getElementById('countBadge')
        if (!badge) {
            badge = document.createElement('span')
            badge.className = 'count-badge'
            badge.id = 'countBadge'
            document.querySelector('.section-header').appendChild(badge)
        }
        badge.textContent = (parseInt(badge.textContent) || 0) + delta
    }

    function copiar(btn, url) {
        navigator.clipboard.writeText(url)
        const orig = btn.textContent
        btn.textContent = 'copiado ✓'
        toast('✓ copiado al portapapeles')
        setTimeout(() => btn.textContent = orig, 1800)
    }

    async function eliminar(btn) {
        const card = btn.closest('.url-card')
        const shortUrl = card.dataset.short
        if (!confirm(`¿Borrar worito.tech/${shortUrl}?`)) return
        try {
            const res = await fetch(`/url/${shortUrl}`, { method: 'DELETE' })
            const data = await res.json()
            if (data.error) { toast(data.error, true); return }
            card.classList.add('deleting')
            setTimeout(() => {
                card.remove()
                actualizarContador(-1)
                if (!document.querySelector('.url-card')) {
                    document.getElementById('urlList').innerHTML = '<div class="empty-state" id="emptyState"><p>Todavía no acortaste ningún enlace.</p></div>'
                }
            }, 250)
            toast('enlace eliminado')
        } catch { toast('Error al eliminar', true) }
    }

    function toggleEdit(btn) {
        const card = btn.closest('.url-card')
        card.querySelector('.edit-bar').classList.toggle('visible')
        if (card.querySelector('.edit-bar').classList.contains('visible')) {
            card.querySelector('.edit-input').focus()
        }
    }

    function cancelarEdit(btn) {
        btn.closest('.edit-bar').classList.remove('visible')
    }

    async function guardarAlias(btn) {
        const card = btn.closest('.url-card')
        const editBar = card.querySelector('.edit-bar')
        const oldAlias = card.dataset.short
        const newAlias = card.querySelector('.edit-input').value.trim()
        if (!newAlias || newAlias === oldAlias) { editBar.classList.remove('visible'); return }
        try {
            const res = await fetch(`/url/${oldAlias}`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newAlias })
            })
            const data = await res.json()
            if (data.error) { toast(data.error, true); return }
            card.dataset.short = newAlias
            card.querySelector('.short-link-display').textContent = `worito.tech/${newAlias}`
            card.querySelector('.short-link-display').href = `/${newAlias}`
            const statsLink = card.querySelector('a[href^="/stats/"]')
            if (statsLink) statsLink.href = `/stats/${newAlias}`
            editBar.classList.remove('visible')
            toast('✓ alias actualizado')
        } catch { toast('Error al actualizar', true) }
    }
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
