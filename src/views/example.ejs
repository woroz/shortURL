<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #f7f5f0;
            --card: #ffffff;
            --border: #e8e4dc;
            --border2: #d4cfc4;
            --accent: #1a1a1a;
            --green: #2d6a2d;
            --green-bg: #eef5ee;
            --green-light: #c8e6c8;
            --text: #1a1a1a;
            --muted: #8a8478;
            --tag-bg: #f0ede6;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            padding: 0;
        }

        nav {
            border-bottom: 1px solid var(--border);
            padding: 1.4rem 2.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(247,245,240,0.85);
            backdrop-filter: blur(8px);
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .nav-logo {
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: -0.02em;
            color: var(--text);
            text-decoration: none;
        }

        .nav-logo em {
            font-style: normal;
            color: var(--green);
        }

        .nav-links {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }

        .nav-link {
            font-family: 'DM Mono', monospace;
            font-size: 0.75rem;
            color: var(--muted);
            text-decoration: none;
            padding: 0.35rem 0.8rem;
            border-radius: 100px;
            border: 1px solid var(--border2);
            background: var(--tag-bg);
            transition: color 0.15s, border-color 0.15s;
        }

        .nav-link:hover { color: var(--text); border-color: var(--text); }

        .nav-link.active {
            color: var(--text);
            border-color: var(--text);
            background: var(--card);
        }

        /* HERO */
        .hero {
            max-width: 560px;
            margin: 0 auto;
            padding: 4rem 1.5rem 2rem;
        }

        .hero-label {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .hero-label::before {
            content: '';
            display: block;
            width: 18px;
            height: 1px;
            background: var(--muted);
        }

        .hero h1 {
            font-size: 2.4rem;
            font-weight: 300;
            letter-spacing: -0.03em;
            line-height: 1.15;
            margin-bottom: 2.5rem;
            color: var(--text);
        }

        .hero h1 strong { font-weight: 700; }

        /* FORM */
        .form-card {
            background: var(--card);
            border-radius: 20px;
            padding: 1.75rem;
            margin-bottom: 1rem;
            box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        }

        .field { margin-bottom: 1rem; }

        .field label {
            font-family: 'DM Mono', monospace;
            font-size: 0.6rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: block;
            margin-bottom: 0.5rem;
        }

        input[type="text"] {
            width: 100%;
            background: var(--bg);
            border: 1px solid var(--border2);
            border-radius: 12px;
            color: var(--text);
            font-family: 'DM Mono', monospace;
            font-size: 0.85rem;
            padding: 0.85rem 1rem;
            outline: none;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        input[type="text"]:focus {
            border-color: var(--text);
            box-shadow: 0 0 0 3px rgba(26,26,26,0.06);
        }

        input[type="text"]::placeholder { color: #c0bbb2; }

        .alias-wrap {
            display: flex;
            align-items: center;
            background: var(--bg);
            border: 1px solid var(--border2);
            border-radius: 12px;
            overflow: hidden;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .alias-wrap:focus-within {
            border-color: var(--text);
            box-shadow: 0 0 0 3px rgba(26,26,26,0.06);
        }

        .alias-prefix {
            font-family: 'DM Mono', monospace;
            font-size: 0.8rem;
            color: var(--green);
            padding: 0.85rem 0.5rem 0.85rem 1rem;
            white-space: nowrap;
            user-select: none;
        }

        .alias-wrap input {
            border: none;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            padding-left: 0.25rem;
        }

        .alias-wrap input:focus { box-shadow: none; }

        .divider {
            height: 1px;
            background: var(--border);
            margin: 1.25rem 0;
        }

        .btn {
            width: 100%;
            padding: 0.9rem 1rem;
            background: var(--text);
            color: #f7f5f0;
            border: none;
            border-radius: 12px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
            letter-spacing: -0.01em;
            transition: opacity 0.15s, transform 0.1s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
        }

        .btn:hover { opacity: 0.82; }
        .btn:active { transform: scale(0.99); }

        /* URLS */
        .urls-section {
            max-width: 560px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1rem;
        }

        .section-title {
            font-family: 'DM Mono', monospace;
            font-size: 0.62rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .count-badge {
            font-family: 'DM Mono', monospace;
            font-size: 0.62rem;
            background: var(--tag-bg);
            border: 1px solid var(--border2);
            color: var(--muted);
            padding: 0.15rem 0.5rem;
            border-radius: 100px;
        }

        .url-list {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }

        .url-card {
            background: var(--card);
            border-radius: 16px;
            display: flex;
            overflow: hidden;
            transition: border-color 0.15s, box-shadow 0.15s;
        }

        .url-card:hover {
            border-color: var(--border2);
            box-shadow: 0 2px 16px rgba(0,0,0,0.06);
        }

        .url-img {
            width: 90px;
            min-width: 90px;
            background: var(--card);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .url-img img {
            width: 52px;
            height: 52px;
            object-fit: contain;
        }

        .url-img-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: var(--border2);
        }

        .url-content {
            padding: 1rem 1.1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.3rem;
            min-width: 0;
            border-left: 1px solid var(--border);
        }

        .url-title {
            font-size: 0.88rem;
            font-weight: 500;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .url-desc {
            font-size: 0.75rem;
            color: var(--muted);
            font-weight: 300;
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .url-meta {
            margin-top: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .short-link {
            font-family: 'DM Mono', monospace;
            font-size: 0.72rem;
            background: var(--green-bg);
            color: var(--green);
            border: 1px solid var(--green-light);
            border-radius: 8px;
            padding: 0.2rem 0.55rem;
            text-decoration: none;
            transition: background 0.15s;
        }

        .short-link:hover { background: var(--green-light); }

        .copy-btn {
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            background: none;
            border: 1px solid var(--border2);
            color: var(--muted);
            border-radius: 6px;
            padding: 0.2rem 0.5rem;
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }

        .copy-btn:hover { color: var(--text); border-color: var(--text); }

        .original-link {
            display: block;
            font-family: 'DM Mono', monospace;
            font-size: 0.65rem;
            color: var(--muted);
            text-decoration: none;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-top: 0.15rem;
        }

        .original-link:hover { color: var(--text); }

        .empty-state {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--muted);
        }

        .empty-state p {
            font-size: 0.82rem;
            font-weight: 300;
        }
    </style>
</head>
<body>

    <nav>
        <a href="/" class="nav-logo">worito<em>.tech</em></a>
        <div class="nav-links">
            <a href="/stats" class="nav-link">estadísticas</a>
            <span class="nav-link active">acortador de URLs</span>
        </div>
    </nav>

    <div class="hero">
        <div class="hero-label">acortar enlace</div>
        <h1>URLs <strong>cortas</strong>,<br>links que duran.</h1>

        <div class="form-card">
            <form action="/url" method="POST">
                <div class="field">
                    <label>URL larga</label>
                    <input type="text" name="longUrl" placeholder="https://ejemplo.com/una-url-muy-larga" required>
                </div>
                <div class="field">
                    <label>Alias personalizado — opcional</label>
                    <div class="alias-wrap">
                        <span class="alias-prefix">worito.tech/</span>
                        <input type="text" name="customAlias" placeholder="mi-alias">
                    </div>
                </div>
                <div class="divider"></div>
                <button type="submit" class="btn">
                    Acortar enlace
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
            </form>
        </div>
    </div>

    <div class="urls-section">
        <div class="section-header">
            <span class="section-title">Mis enlaces</span>
            <% if (urls && urls.length > 0) { %>
                <span class="count-badge"><%= urls.length %></span>
            <% } %>
        </div>

        <div class="url-list">
            <% if (urls && urls.length > 0) { %>
                <% urls.forEach(function(url) { %>
                    <div class="url-card">
                        <div class="url-img">
                            <% try { const domain = new URL(url.longUrl).hostname %>
                                <img src="https://www.google.com/s2/favicons?domain=<%= domain %>&sz=128" alt="">
                            <% } catch(e) { %>
                                <div class="url-img-placeholder">↗</div>
                            <% } %>
                        </div>
                        <div class="url-content">
                            <% if (url.titulo) { %>
                                <div class="url-title"><%= url.titulo %></div>
                            <% } %>
                            <% if (url.descripcion) { %>
                                <div class="url-desc"><%= url.descripcion %></div>
                            <% } %>
                            <div class="url-meta">
                                <a href="/<%= url.shortUrl %>" target="_blank" class="short-link">worito.tech/<%= url.shortUrl %></a>
                                <button class="copy-btn" onclick="navigator.clipboard.writeText('https://worito.tech/<%= url.shortUrl %>');this.textContent='copiado';setTimeout(()=>this.textContent='copiar',1800)">copiar</button>
                                <a href="/stats/<%= url.shortUrl %>" class="copy-btn">ver stats</a>
                            </div>
                            <a href="<%= url.longUrl %>" target="_blank" rel="noopener noreferrer" class="original-link"><%= url.longUrl %></a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <p>Todavia no acortaste ningun enlace.</p>
                </div>
            <% } %>
        </div>
    </div>

</body>
</html>
