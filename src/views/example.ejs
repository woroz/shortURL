<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0a0a0a;
            --surface: #111111;
            --surface2: #1a1a1a;
            --border: #2a2a2a;
            --accent: #b5ff4d;
            --accent2: #4dffb5;
            --text: #f0f0f0;
            --muted: #666;
            --danger: #ff4d4d;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Syne', sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 3rem 1rem;
        }

        .container {
            width: 100%;
            max-width: 680px;
        }

        /* HEADER */
        .header {
            margin-bottom: 3rem;
            display: flex;
            align-items: baseline;
            gap: 1rem;
        }

        .logo {
            font-size: 2.2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1;
        }

        .logo span {
            color: var(--accent);
        }

        .tagline {
            font-family: 'Space Mono', monospace;
            font-size: 0.7rem;
            color: var(--muted);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        /* FORM CARD */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-bottom: 1rem;
        }

        .input-wrap {
            position: relative;
        }

        .input-wrap label {
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            display: block;
            margin-bottom: 0.4rem;
        }

        input[type="text"] {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: 'Space Mono', monospace;
            font-size: 0.85rem;
            padding: 0.85rem 1rem;
            outline: none;
            transition: border-color 0.2s;
        }

        input[type="text"]:focus {
            border-color: var(--accent);
        }

        input[type="text"]::placeholder {
            color: var(--muted);
        }

        .alias-row {
            display: flex;
            align-items: center;
            gap: 0;
            background: var(--surface2);
            border: 1px solid var(--border);
            border-radius: 10px;
            overflow: hidden;
            transition: border-color 0.2s;
        }

        .alias-row:focus-within {
            border-color: var(--accent);
        }

        .alias-prefix {
            font-family: 'Space Mono', monospace;
            font-size: 0.8rem;
            color: var(--accent);
            padding: 0.85rem 0.75rem 0.85rem 1rem;
            white-space: nowrap;
            border-right: 1px solid var(--border);
            background: #1f1f1f;
        }

        .alias-row input {
            border: none;
            border-radius: 0;
            background: transparent;
            flex: 1;
        }

        .btn {
            width: 100%;
            padding: 1rem;
            background: var(--accent);
            color: #0a0a0a;
            border: none;
            border-radius: 10px;
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            letter-spacing: 0.02em;
            transition: opacity 0.15s, transform 0.1s;
        }

        .btn:hover { opacity: 0.88; }
        .btn:active { transform: scale(0.99); }

        /* URLS LIST */
        .section-label {
            font-family: 'Space Mono', monospace;
            font-size: 0.65rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.12em;
            margin-bottom: 1rem;
        }

        .url-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .url-item {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            transition: border-color 0.2s;
        }

        .url-item:hover {
            border-color: #3a3a3a;
        }

        .url-thumb {
            width: 100px;
            min-width: 100px;
            background: var(--surface2);
            overflow: hidden;
        }

        .url-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .url-thumb-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--border);
        }

        .url-body {
            padding: 1rem 1.2rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
            min-width: 0;
        }

        .url-title {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .url-desc {
            font-size: 0.78rem;
            color: var(--muted);
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .url-links {
            margin-top: 0.4rem;
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }

        .url-short {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .url-short-badge {
            font-family: 'Space Mono', monospace;
            font-size: 0.75rem;
            background: #1a2a0a;
            color: var(--accent);
            border: 1px solid #2a3a1a;
            border-radius: 6px;
            padding: 0.2rem 0.6rem;
            text-decoration: none;
            transition: background 0.15s;
        }

        .url-short-badge:hover {
            background: #223510;
        }

        .copy-btn {
            background: none;
            border: none;
            color: var(--muted);
            cursor: pointer;
            font-size: 0.8rem;
            padding: 0.1rem 0.3rem;
            border-radius: 4px;
            transition: color 0.15s;
            font-family: 'Space Mono', monospace;
        }

        .copy-btn:hover { color: var(--accent); }

        .url-original {
            font-family: 'Space Mono', monospace;
            font-size: 0.68rem;
            color: var(--muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-decoration: none;
        }

        .url-original:hover { color: var(--accent2); }

        .empty {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--muted);
            font-family: 'Space Mono', monospace;
            font-size: 0.8rem;
        }

        .empty-icon { font-size: 2rem; margin-bottom: 0.75rem; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div>
                <div class="logo">worito<span>.tech</span></div>
                <div class="tagline">acortador de URLs</div>
            </div>
        </div>

        <div class="card">
            <form action="/url" method="POST">
                <div class="input-group">
                    <div class="input-wrap">
                        <label>URL larga</label>
                        <input type="text" name="longUrl" placeholder="https://ejemplo.com/url-muy-larga..." required>
                    </div>
                    <div class="input-wrap">
                        <label>Alias personalizado (opcional)</label>
                        <div class="alias-row">
                            <span class="alias-prefix">worito.tech/</span>
                            <input type="text" name="customAlias" placeholder="mi-alias">
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn">Acortar URL →</button>
            </form>
        </div>

        <div class="section-label">Mis URLs</div>

        <div class="url-list">
            <% if (urls && urls.length > 0) { %>
                <% urls.forEach(function(url) { %>
                    <div class="url-item">
                        <div class="url-thumb">
                            <% if (url.imagen) { %>
                                <img src="<%= url.imagen %>" alt="">
                            <% } else { %>
                                <div class="url-thumb-placeholder">🔗</div>
                            <% } %>
                        </div>
                        <div class="url-body">
                            <% if (url.titulo) { %>
                                <div class="url-title"><%= url.titulo %></div>
                            <% } %>
                            <% if (url.descripcion) { %>
                                <div class="url-desc"><%= url.descripcion %></div>
                            <% } %>
                            <div class="url-links">
                                <div class="url-short">
                                    <a href="/<%= url.shortUrl %>" target="_blank" class="url-short-badge">worito.tech/<%= url.shortUrl %></a>
                                    <button class="copy-btn" onclick="navigator.clipboard.writeText('https://worito.tech/<%= url.shortUrl %>');this.textContent='✓';setTimeout(()=>this.textContent='copy',1500)">copy</button>
                                </div>
                                <a href="<%= url.longUrl %>" target="_blank" rel="noopener noreferrer" class="url-original"><%= url.longUrl %></a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="empty">
                    <div class="empty-icon">🔗</div>
                    No hay URLs acortadas todavía.
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
